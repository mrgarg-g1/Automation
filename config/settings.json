{
  "daily_cap_total": 30,
  "fit_threshold": 60,
  "delay_seconds_between_applications": [45, 120],
  "pause_every_n_applications": 5,
  "pause_minutes": [3, 5],
  "platforms": [
    {
      "name": "ziprecruiter",
      "enabled": true,
      "daily_cap": 15,
      "playbook": "playbooks/ziprecruiter.md"
    },
    {
      "name": "remote_co",
      "enabled": true,
      "daily_cap": 8,
      "playbook": "playbooks/remote-co.md",
      "note": "Most listings redirect to company ATS pages — hand off to playbooks/ats-direct.md"
    },
    {
      "name": "instahyre",
      "enabled": true,
      "daily_cap": 8,
      "playbook": "playbooks/instahyre.md"
    },
    {
      "name": "flexjobs",
      "enabled": false,
      "daily_cap": 5,
      "playbook": "playbooks/flexjobs.md",
      "note": "DISABLED by default: FlexJobs requires a paid subscription to apply. Enable only after subscribing."
    },
    {
      "name": "protocol_jobs",
      "enabled": true,
      "daily_cap": 5,
      "playbook": "playbooks/protocol-jobs.md"
    },
    {
      "name": "naukri",
      "enabled": true,
      "daily_cap": 12,
      "playbook": "playbooks/naukri.md",
      "note": "Company-site apply only. Never use Naukri Apply Now / Easy Apply — the user already does that themselves."
    }
  ],
  "search": {
    "roles": [
      "Data Scientist",
      "AI Engineer",
      "Machine Learning Engineer"
    ],
    "locations": ["Remote", "Gurugram", "Noida", "Delhi"],
    "remote_only": false,
    "remote_worldwide": true,
    "hybrid_ok_cities": ["Gurugram", "Gurgaon", "Noida", "Delhi", "New Delhi", "NCR", "Delhi NCR"],
    "posted_within_days": 7,
    "exclude_keywords": ["clearance", "citizen only", "onsite only"],
    "exclude_if_required": []
  },
  "company_filter": {
    "tier": "mid",
    "skip_top_tier": true,
    "prefer_ncr_midsize": true,
    "max_applies_per_company": 5,
    "current_employer_names": [
      "Syren Cloud",
      "Syren"
    ],
    "note": "Target mid-size employers like Phoenix Contact and Noida/Gurugram/Delhi peers (and similar-size India-remote firms). Fully remote worldwide is still allowed. Never apply to current employer Syren Cloud. Skip a company after 5 applied tracker rows. Do not apply to Amazon, Flipkart, FAANG, Big 4, Indian IT majors, or other household MNCs/unicorns. Check with: python3 scripts/company_filter.py --company NAME",
    "examples_target": [
      "Phoenix Contact",
      "Appsquadz",
      "Areness",
      "LatentView",
      "Comviva",
      "SquadStack.ai"
    ],
    "exclude_company_names": [
